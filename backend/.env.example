# ---- AI (choose one provider; both have free tiers) --------------------------
# Google AI Studio (Gemini): GEMINI_API_KEY starts with "AIza"
GEMINI_API_KEY=
GEMINI_MODEL=

# Any OpenAI-compatible free endpoint (e.g. Groq) -----------------------------
# AI_PROVIDER=groq | gemini | openai_compat | ollama | auto
AI_PROVIDER=auto
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# Local fallback
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# ---- Research discovery (all free, keys optional) ---------------------------
# A contact email is strongly recommended for Crossref/OpenAlex polite pools.
CONTACT_EMAIL=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=
ARXIV_EMAIL=
ENABLE_SEMANTIC_SCHOLAR=true
ENABLE_ARXIV=true

# ---- Services / storage ------------------------------------------------------
GROBID_URL=http://localhost:8070
DATABASE_URL=sqlite:///./storage/citeverify.db
MAX_UPLOAD_MB=20
MAX_CLAIMS=16
MAX_VERIFY_CLAIMS=12

# ---- Deployment --------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
# Local defaults are already set; in production add your frontend URL.
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
